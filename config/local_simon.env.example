# Simon 로컬 설정 — 이 파일을 local_simon.env 로 복사한 뒤 경로만 수정 (# 줄은 무시)
# 64bit Python + Whisper 필수 (Kiwoom 32bit python 아님)

SIMON_RESIDENT_PYTHON=C:\Python312\python.exe
SIMON_MAIN_PYTHON=C:\Python311_32\python.exe
# 본인 check_simon_status.ps1 이 8080 이면 8080, 18080 이면 18080
STOCK_SERVER_PORT=8080
SIMON_STT_DEVICE_INDEX=1
SIMON_STT_SAMPLE_RATE=48000
SIMON_STT_MODEL=small
SIMON_STT_LANGUAGE=ko
